{
  "manifest_version": 2,
  "version": "1.2.4",
  "name": "\u90bb\u820d\u6865\u63a5\u63d2\u4ef6",
  "description": "邻舍，力求借助Anima本地绘图模型搭配LLM，通过日程和朋友圈记录，自动运行一个AI小镇，就好像二次元角色活了一整天。插件给予了角色暂时桥接进入MaiBot的能力，方便切换人格之外，还赋予了自动Anima配图能力",
  "author": {
    "name": "icecranberry",
    "url": "https://github.com/icecranberry/linshe-maibot-adapter"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/icecranberry/linshe-maibot-adapter",
    "homepage": "https://github.com/icecranberry/linshe-maibot-adapter",
    "documentation": "https://github.com/icecranberry/linshe-maibot-adapter",
    "issues": "https://github.com/icecranberry/linshe-maibot-adapter/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.1.4"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.icecranberry.linshe-bridge",
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  }
}
